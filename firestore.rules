rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@ichon-schedule.app';
    }
    // 누구나 볼 수 있고, 관리자 비밀번호로 로그인한 사람만 고칠 수 있어요
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // 응원 하트와 게임 기록은 직원 누구나 남길 수 있어요
    match /shared/hearts {
      allow create, update: if request.resource.data.size() <= 60;
    }
    match /shared/ranks {
      allow create, update: if request.resource.data.size() <= 60;
    }
  }
}
